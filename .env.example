# ========================================================
# 360 Phone Shop Management System - Environment Variables
# Copy this file to .env on your server and change secrets!
# ========================================================

# --------------------------------------------------------
# General / Port Configuration
# --------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
NGINX_PORT=80
SERVER_PORT=3333

# --------------------------------------------------------
# PostgreSQL Configuration
# --------------------------------------------------------
POSTGRES_DB=phone_shop_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_strong_postgres_password_here
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/phone_shop_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_super_strong_postgres_password_here

# --------------------------------------------------------
# Redis Configuration
# --------------------------------------------------------
REDIS_PASSWORD=your_super_strong_redis_password_here
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# --------------------------------------------------------
# RustFS / S3 Object Storage Configuration
# --------------------------------------------------------
RUSTFS_ACCESS_KEY=your_rustfs_access_key
RUSTFS_SECRET_KEY=your_super_strong_rustfs_secret_here
RUSTFS_CONSOLE_ENABLE=false
RUSTFS_BUCKET=sarana
RUSTFS_BUCKETS=sarana,product,store,users,category,brand,model
AWS_REGION=us-east-1

# --------------------------------------------------------
# SMTP / Password Reset
# --------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_app_password
MAIL_FROM=noreply@example.com
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# --------------------------------------------------------
# Security / JWT Configuration (HS256 / HS384 / HS512 Base64 Key)
# Generate with: openssl rand -base64 64
# --------------------------------------------------------
JWT_SECRET_BASE64=your_generated_base64_jwt_secret_key_here

# Password used only when the database seeder creates default users.
APP_SEEDER_DEFAULT_USER_PASSWORD=your_strong_seeded_user_password_here

# --------------------------------------------------------
# CORS Configuration (Comma-separated origins)
# --------------------------------------------------------
CORS_ALLOWED_ORIGIN=https://360-system.vercel.app,https://yourdomain.com

# --------------------------------------------------------
# Database Seeder (Set to false once initial admin is seeded)
# --------------------------------------------------------
APP_SEEDER_ENABLED=true
APP_SEEDER_FORCE=false
